# The VPS agent (deploy/vps-agent.sh), started by jev-agent.timer. Runs as the unprivileged user.
[Unit]
Description=jev-trader VPS agent: deploy from GitHub, push status reports
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/jev-trader/deploy/vps-agent.sh
Nice=15
MemoryMax=1G
# Worst case: 2 x 15 min (last 24 h) + 2 x 20 min (one finished day), each step capped by `timeout`.
TimeoutStartSec=90min
